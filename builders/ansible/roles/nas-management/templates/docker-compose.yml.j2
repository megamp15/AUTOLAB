# Managed by AUTOLAB. The web UI remains on jwst, behind Pocket ID.
services:
  hawser:
    image: {{ autolab_nas_hawser_image }}
    restart: unless-stopped
    environment:
      TOKEN_FILE: /run/secrets/hawser-token
      AGENT_NAME: "{{ inventory_hostname }}"
      STACKS_DIR: /volume1/docker
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /volume1/docker:/volume1/docker
      - ./secrets/hawser-token:/run/secrets/hawser-token:ro
    ports:
      - "{{ autolab_nas_management_ip }}:{{ autolab_nas_hawser_port }}:2376"
  dockhand-launcher:
    image: {{ autolab_nas_launcher_image }}
    restart: unless-stopped
    volumes:
      - ./launcher.conf:/etc/nginx/conf.d/default.conf:ro
    ports:
      - "{{ autolab_nas_management_ip }}:{{ autolab_nas_launcher_port }}:80"
      - "127.0.0.1:{{ autolab_nas_launcher_port }}:80"
