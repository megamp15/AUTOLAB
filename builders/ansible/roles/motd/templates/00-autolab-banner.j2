#!/bin/sh
# Machine banner, fading top to bottom. Deployed by the Ansible role motd;
# change the role, not this.
printf '\n'
if [ -r /etc/autolab/banner ]; then
    awk -v colors='{{ autolab_motd_gradient | join(" ") }}' '
        BEGIN { n = split(colors, c, " ") }
        { printf "\033[1;38;5;%sm%s\033[0m\n", c[NR < n ? NR : n], $0 }
    ' /etc/autolab/banner
else
    printf '  \033[1;38;5;{{ autolab_motd_accent }}m%s\033[0m\n' '{{ autolab_motd_text | upper }}'
fi
