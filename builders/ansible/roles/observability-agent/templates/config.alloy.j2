// Managed by Ansible — roles/observability-agent. Local edits are overwritten.
//
// Alloy is an OpenTelemetry Collector distribution. These are its Prometheus
// pipelines; OTLP receivers for traces and profiles can be added here later
// without changing anything else about collection.

// ---------------------------------------------------------------------------
// Metrics: the embedded node exporter, so there is no second package to install
// or keep current.
// ---------------------------------------------------------------------------

prometheus.exporter.unix "node" {
  // Filesystem metrics for overlay and tmpfs mounts describe containers and
  // RAM disks rather than real storage, and drown out the mounts that matter.
  filesystem {
    fs_types_exclude = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
  }
  // Anything a host knows that no exporter does — the backup collector on
  // the stack host writes here. Empty on most hosts, and that is fine.
  textfile {
    directory = "/var/lib/autolab/textfile"
  }
}

prometheus.scrape "node" {
  targets         = prometheus.exporter.unix.node.targets
  forward_to      = [prometheus.remote_write.stack.receiver]
  scrape_interval = "{{ autolab_obs_scrape_interval }}"
}

// Alloy's own health. Without this the agent is the one component that cannot
// report on itself, and "no metrics" is ambiguous between a dead agent, a dead
// host and a broken network.
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.remote_write.stack.receiver]
  scrape_interval = "{{ autolab_obs_scrape_interval }}"
}

prometheus.remote_write "stack" {
  endpoint {
    url = "{{ autolab_obs_metrics_endpoint }}"
  }
}

// ---------------------------------------------------------------------------
// Logs: journald rather than tailing files. Everything on these hosts logs
// through systemd, and journald already carries unit and priority as
// structured fields that file tailing would have to parse back out.
// ---------------------------------------------------------------------------

// The labels block below cannot set `job`. loki.source.journal names the job
// after the component itself — `loki.source.journal.journal` — and that wins,
// so {job="journald"} matched nothing while logs arrived the whole time under a
// label nothing queried. Relabelling downstream is where the value sticks.
//
// `unit` is promoted from the journal's own metadata for the same reason: it
// was queried by a dashboard and never existed, so the panel grouped by a
// missing label and drew one meaningless line.
// Two relabel blocks, because the two labels are available at different points.
//
// `unit` comes from a __journal_* label, and those exist only *inside*
// loki.source.journal — they are stripped before entries reach anything
// downstream. Extracting it therefore has to happen in the component's own
// relabel_rules. This block exports rules rather than receiving entries, which
// is what the empty forward_to means.
loki.relabel "journal_rules" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

// `job` needs the opposite treatment. The component sets it to its own path
// after the labels block is applied, so the only place the value sticks is
// downstream of the source.
loki.relabel "journal" {
  forward_to = [loki.write.stack.receiver]

  rule {
    target_label = "job"
    replacement  = "journald"
  }
}

loki.source.journal "journal" {
  forward_to    = [loki.relabel.journal.receiver]
  relabel_rules = loki.relabel.journal_rules.rules
  labels        = {
    host = "{{ inventory_hostname }}",
  }
}

loki.write "stack" {
  endpoint {
    url = "{{ autolab_obs_logs_endpoint }}"
  }
}
{% if ((autolab_builder | default({})).observability | default({})).stack | default(false) | bool and autolab_management_address is defined %}

// ---------------------------------------------------------------------------
// Ingest for the management plane. A tenant guest is on a tailnet this host is
// not, so it ships over the bridge to the address declared in the machines
// map. These two listeners answer there and forward into the same pipelines
// this host's own telemetry takes: a guest can push, and that is all it can
// do — Prometheus and Loki themselves stay bound to the tailnet address.
// ---------------------------------------------------------------------------

prometheus.receive_http "management" {
  http {
    listen_address = "{{ autolab_management_address }}"
    listen_port    = {{ autolab_obs_ingest_metrics_port }}
  }
  forward_to = [prometheus.remote_write.stack.receiver]
}

// Timestamps come from the sender. The default restamps every line at receipt,
// which would put a tenant's journal on this host's clock and lose the order
// of anything that arrived after a retry.
loki.source.api "management" {
  http {
    listen_address = "{{ autolab_management_address }}"
    listen_port    = {{ autolab_obs_ingest_logs_port }}
  }
  use_incoming_timestamp = true
  forward_to             = [loki.write.stack.receiver]
}
{% endif %}
