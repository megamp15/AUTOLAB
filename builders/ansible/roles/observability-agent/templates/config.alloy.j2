// Managed by Ansible — roles/observability-agent. Local edits are overwritten.
//
// Alloy is an OpenTelemetry Collector distribution. These are its Prometheus
// pipelines; OTLP receivers for traces and profiles can be added here later
// without changing anything else about collection.

// ---------------------------------------------------------------------------
// Metrics: the embedded node exporter, so there is no second package to install
// or keep current.
// ---------------------------------------------------------------------------

prometheus.exporter.unix "node" {
  // Filesystem metrics for overlay and tmpfs mounts describe containers and
  // RAM disks rather than real storage, and drown out the mounts that matter.
  filesystem {
    fs_types_exclude = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
  }
}

prometheus.scrape "node" {
  targets         = prometheus.exporter.unix.node.targets
  forward_to      = [prometheus.remote_write.stack.receiver]
  scrape_interval = "{{ autolab_obs_scrape_interval }}"
}

// Alloy's own health. Without this the agent is the one component that cannot
// report on itself, and "no metrics" is ambiguous between a dead agent, a dead
// host and a broken network.
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.remote_write.stack.receiver]
  scrape_interval = "{{ autolab_obs_scrape_interval }}"
}

prometheus.remote_write "stack" {
  endpoint {
    url = "{{ autolab_obs_metrics_endpoint }}"
  }
}

// ---------------------------------------------------------------------------
// Logs: journald rather than tailing files. Everything on these hosts logs
// through systemd, and journald already carries unit and priority as
// structured fields that file tailing would have to parse back out.
// ---------------------------------------------------------------------------

// The labels block below cannot set `job`. loki.source.journal names the job
// after the component itself — `loki.source.journal.journal` — and that wins,
// so {job="journald"} matched nothing while logs arrived the whole time under a
// label nothing queried. Relabelling downstream is where the value sticks.
//
// `unit` is promoted from the journal's own metadata for the same reason: it
// was queried by a dashboard and never existed, so the panel grouped by a
// missing label and drew one meaningless line.
loki.relabel "journal" {
  forward_to = [loki.write.stack.receiver]

  rule {
    target_label = "job"
    replacement  = "journald"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "journal" {
  forward_to = [loki.relabel.journal.receiver]
  labels     = {
    host = "{{ inventory_hostname }}",
  }
}

loki.write "stack" {
  endpoint {
    url = "{{ autolab_obs_logs_endpoint }}"
  }
}
