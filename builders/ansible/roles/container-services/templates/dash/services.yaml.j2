# Managed by Ansible — roles/container-services (templates/dash). https://gethomepage.dev/configs/services/
# Links are what a browser opens; the dot is a check made from jwst.
{% set lab = autolab_services_dash_label ~ '.' ~ autolab_services_dash_zone %}
{% set zone = autolab_services_dash_zone %}
{% set tn = autolab_services_fqdn.split('.', 1)[1] %}
- Applications:
    - Immich:
        icon: immich.png
        href: https://immich.{{ lab }}
        description: Photo gallery
        siteMonitor: http://singularity.{{ tn }}:2283/api/server/ping
    - AdventureLog:
        icon: mdi-map-marker-path
        href: https://adventurelog.{{ lab }}
        description: Travel log
        siteMonitor: http://nebula.{{ tn }}:8098/health
    - Forgejo:
        icon: forgejo.png
        href: https://forgejo.{{ lab }}
        description: Git — mirrors and forks
        siteMonitor: http://nebula.{{ tn }}:8100/api/healthz
    - Karakeep:
        icon: mdi-bookmark-multiple
        href: https://karakeep.{{ lab }}
        description: Bookmarks that fetch and tag themselves
        siteMonitor: http://nebula.{{ tn }}:{{ autolab_service_catalog.karakeep.port }}/api/health
    - Jellyfin:
        icon: mdi-movie-open
        href: https://jellyfin.{{ lab }}
        description: Films and shows
        siteMonitor: http://aurora.{{ tn }}:{{ autolab_service_catalog.jellyfin.port }}/health
    - Prowlarr:
        icon: mdi-magnify
        href: https://prowlarr.{{ lab }}
        description: The indexers, for Sonarr and Radarr
        siteMonitor: http://aurora.{{ tn }}:{{ autolab_service_catalog.prowlarr.port }}/ping
    - Sonarr:
        icon: mdi-television-classic
        href: https://sonarr.{{ lab }}
        description: Finds and files shows, anime and dramas
        siteMonitor: http://aurora.{{ tn }}:{{ autolab_service_catalog.sonarr.port }}/ping
    - Radarr:
        icon: mdi-filmstrip
        href: https://radarr.{{ lab }}
        description: Finds and files films
        siteMonitor: http://aurora.{{ tn }}:{{ autolab_service_catalog.radarr.port }}/ping
    - Bazarr:
        icon: mdi-subtitles
        href: https://bazarr.{{ lab }}
        description: Subtitles for the library
        siteMonitor: http://aurora.{{ tn }}:{{ autolab_service_catalog.bazarr.port }}/
    - SABnzbd:
        icon: mdi-download
        href: https://sabnzbd.{{ lab }}
        description: Usenet downloads
        siteMonitor: http://aurora.{{ tn }}:{{ autolab_service_catalog.sabnzbd.port }}/
    - qBittorrent:
        icon: mdi-magnet
        href: https://qbittorrent.{{ lab }}
        description: Torrents, through Mullvad
        siteMonitor: http://aurora.{{ tn }}:{{ autolab_service_catalog.qbittorrent.port }}/
    - Lidarr:
        icon: mdi-music
        href: https://lidarr.{{ lab }}
        description: Finds and files music
        siteMonitor: http://aurora.{{ tn }}:{{ autolab_service_catalog.lidarr.port }}/ping
    - Seerr:
        icon: mdi-movie-search
        href: https://seerr.{{ lab }}
        description: Browse and request films and shows
        siteMonitor: http://aurora.{{ tn }}:{{ autolab_service_catalog.seerr.port }}/api/v1/status
    - Sure:
        icon: mdi-finance
        href: https://sure.{{ lab }}
        description: Finances
        siteMonitor: http://nebula.{{ tn }}:8104/up
    - Photos:
        icon: mdi-image-multiple
        href: https://photos.{{ lab }}
        description: Sort and tidy photos
        siteMonitor: http://singularity.{{ tn }}:8099/
{% if 'cosmos' in autolab_services_enabled %}
    - COSMOS:
        icon: mdi-creation
        href: https://cosmos.{{ lab }}
        description: Personal hub
{% endif %}
{% if 'novaflix' in autolab_services_enabled %}
    - Novaflix:
        icon: mdi-movie-open-star-outline
        href: https://novaflix.{{ zone }}
        description: What friends watch
        siteMonitor: http://jwst.{{ tn }}:{{ autolab_services_ports.novaflix }}/api/status
{% endif %}
{% if 'novaflix-admin' in autolab_services_enabled %}
    - Novaflix admin:
        icon: mdi-account-cog-outline
        href: https://novaflix-admin.{{ lab }}
        description: Novaflix accounts
        siteMonitor: http://jwst.{{ tn }}:{{ autolab_services_ports.novaflix_admin }}/api/status
{% endif %}
{% if 'hermes' in autolab_services_enabled %}
    - Hermes:
        icon: mdi-robot-outline
        href: https://hermes.{{ lab }}
        description: Agent dashboard
        siteMonitor: http://jwst.{{ tn }}:{{ autolab_services_ports.hermes }}/api/status
{% endif %}
{% if 'hindsight' in autolab_services_enabled %}
    - Hindsight:
        icon: mdi-brain
        href: https://hindsight.{{ lab }}
        description: Agent memory
        siteMonitor: http://jwst.{{ tn }}:{{ autolab_services_ports.hindsight }}/api/health
    - Hindsight API:
        icon: mdi-api
        href: https://hindsight-api.{{ lab }}/docs
        description: Agent memory API
        siteMonitor: http://jwst.{{ tn }}:{{ autolab_services_ports.hindsight_api }}/health
{% endif %}
    - Pi-hole:
        icon: pi-hole.png
        href: https://pihole.{{ lab }}/admin/
        description: DNS and ad blocking
        siteMonitor: http://magnetosphere.{{ tn }}:8053/admin/
    - Grafana:
        icon: grafana.png
        href: https://grafana.{{ lab }}
        description: Dashboards and alerts
        siteMonitor: http://jwst.{{ tn }}:3000/api/health
    - Prometheus:
        icon: prometheus.png
        href: https://prometheus.{{ lab }}
        description: Metrics
        siteMonitor: http://jwst.{{ tn }}:9090/-/ready
    - Loki:
        icon: loki.png
        href: https://grafana.{{ lab }}/explore
        description: Logs
    - Dockhand:
        icon: mdi-docker
        href: https://dockhand.{{ lab }}
        description: Containers
    - Registry:
        icon: docker.png
        href: https://registry-ui.{{ lab }}
        description: Container images
    - QR codes:
        icon: mdi-qrcode
        href: https://qr.{{ zone }}
        description: Redirecting QR codes
    - Homepage:
        icon: mdi-orbit
        href: https://home.{{ lab }}
        description: The Singularity page
- Server Config:
{% for node in ['xps-pve', 'pve', 'zima-pve'] %}
    - Proxmox · {{ node }}:
        icon: proxmox.png
        href: https://{{ node }}.{{ lab }}
        description: Proxmox VE node
        siteMonitor: https://{{ node }}.{{ tn }}:8006
{% endfor %}
    - Backup Server:
        icon: proxmox.png
        href: https://pbs.{{ lab }}
        description: PBS on ark
    - NAS:
        icon: mdi-nas
        href: https://nas.{{ lab }}
        description: UGOS on singularity
    - Pocket ID:
        icon: sh-pocket-id
        href: https://auth.{{ zone }}
        description: Users, groups, passkeys
        siteMonitor: https://auth.{{ zone }}/.well-known/openid-configuration
    - Tailscale:
        icon: tailscale.png
        href: https://login.tailscale.com/admin/machines
        description: Tailnet console
    - Cloudflare:
        icon: cloudflare.png
        href: https://dash.cloudflare.com
        description: DNS and the tunnel
    - GitHub:
        icon: github.png
        href: https://github.com/megamp15/AUTOLAB
        description: AUTOLAB, all of this as code
