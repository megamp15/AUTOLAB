{% set definitions = {
  'adventurelog': {'launch': autolab_services_adventurelog_public_url, 'callbacks': [autolab_services_adventurelog_public_url ~ '/accounts/oidc/pocketid/login/callback/']},
  'forgejo': {'launch': autolab_services_forgejo_public_url, 'callbacks': [autolab_services_forgejo_public_url ~ '/user/oauth2/PocketID/callback']},
  'tandoor': {'launch': autolab_services_tandoor_public_url, 'callbacks': [autolab_services_tandoor_public_url ~ '/accounts/oidc/pocketid/login/callback/']},
  'airtrail': {'launch': autolab_services_airtrail_public_url, 'callbacks': [autolab_services_airtrail_public_url ~ '/login']},
  'linkace': {'launch': autolab_services_linkace_public_url, 'callbacks': [autolab_services_linkace_public_url ~ '/auth/sso/oidc/callback']},
  'sure': {'launch': autolab_services_sure_public_url, 'callbacks': [autolab_services_sure_public_url ~ '/auth/openid_connect/callback']}
} %}
{
  "issuer": {{ autolab_services_oidc_issuer | to_json }},
  "group": {{ autolab_services_pocketid_group | to_json }},
  "clients": {
{% for name in definitions if name in autolab_services_enabled %}
    {{ name | to_json }}: {{ definitions[name] | to_json }}{{ ',' if not loop.last else '' }}
{% endfor %}
  }
}
