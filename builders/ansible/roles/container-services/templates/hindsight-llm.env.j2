# Managed by Ansible. Hindsight's own model, for extracting and merging facts.
# Empty without a key: the API then starts but cannot retain anything.
{% if autolab_services_hindsight_llm_api_key | length > 0 %}
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY={{ autolab_services_hindsight_llm_api_key }}
HINDSIGHT_API_LLM_BASE_URL={{ autolab_services_hindsight_llm_base_url }}
HINDSIGHT_API_LLM_MODEL={{ autolab_services_hindsight_llm_model }}
{% endif %}
