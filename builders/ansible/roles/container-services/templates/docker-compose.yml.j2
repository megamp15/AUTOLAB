# Managed by Ansible — roles/container-services. Local edits are overwritten.
#
# Assembled from one template per service in the role, driven by this
# machine's builder.services list. A service is added or removed by editing
# that list; nothing here is written by hand.
services:
{% for service in autolab_services_enabled %}

{% include 'services.d/' ~ service ~ '.yml.j2' %}
{% endfor %}

volumes:
{% if 'dockhand' in autolab_services_enabled %}
  dockhand-data:
{% endif %}
{% if 'registry' in autolab_services_enabled %}
  registry-data:
{% endif %}
{% if 'registry-ui' in autolab_services_enabled %}
  registry-ui-data:
{% endif %}
{% if 'diun' in autolab_services_enabled %}
  diun-data:
{% endif %}
{% if 'adventurelog' in autolab_services_enabled %}
  adventurelog-media:
  adventurelog-db:
{% endif %}

# Two bridges besides the default, each there to keep something away from
# something else.
{% if 'dockhand' in autolab_services_enabled or 'qr' in autolab_services_enabled or 'paradigm-tunnel' in autolab_services_enabled %}
networks:
{% endif %}
{% if 'dockhand' in autolab_services_enabled %}
  # Keep the unauthenticated backend off the other services' Docker network.
  # This dedicated bridge still permits Dockhand's outbound registry/Git calls.
  dockhand-control:
{% endif %}
{% if 'qr' in autolab_services_enabled or 'paradigm-tunnel' in autolab_services_enabled %}
  # What the Paradigm tunnel can reach: its connector and the containers meant
  # to be public, nothing else. An admin page, which has no login of its own,
  # is never on it.
  paradigm-public:
{% endif %}
