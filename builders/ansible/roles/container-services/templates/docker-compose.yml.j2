# Managed by Ansible — roles/container-services. Local edits are overwritten.
#
# Assembled from one template per service in the role, driven by this
# machine's builder.services list. A service is added or removed by editing
# that list; nothing here is written by hand.
services:
{% for service in autolab_services_enabled %}

{% include 'services.d/' ~ service ~ '.yml.j2' %}
{% endfor %}

{# A machine whose services keep nothing in a named volume (aurora) gets no
   `volumes:` key at all: Compose refuses an empty one. #}
{% set named_volumes %}
{% if 'dockhand' in autolab_services_enabled %}
  dockhand-data:
{% endif %}
{% if 'registry' in autolab_services_enabled %}
  registry-data:
{% endif %}
{% if 'registry-ui' in autolab_services_enabled %}
  registry-ui-data:
{% endif %}
{% if 'diun' in autolab_services_enabled %}
  diun-data:
{% endif %}
{% if 'adventurelog' in autolab_services_enabled %}
  adventurelog-db:
{% endif %}
{% if 'forgejo' in autolab_services_enabled %}
  forgejo-db:
{% endif %}
{% for app in ['tandoor', 'airtrail', 'sure'] if app in autolab_services_enabled %}
  {{ app }}-db:
{% endfor %}
{% if 'karakeep' in autolab_services_enabled %}
  karakeep-data:
  karakeep-meili:
{% endif %}
{% if 'tandoor' in autolab_services_enabled %}
  tandoor-static:
{% endif %}
{% if 'cosmos' in autolab_services_enabled %}
  cosmos-data:
  # The notes vault checkout cosmos-api reads and writes; GitHub holds the
  # durable copy (megamp15/cosmos-vault), so it needs no backup of its own.
  cosmos-vault:
{% endif %}
{% if 'novaflix' in autolab_services_enabled %}
  novaflix-data:
{% endif %}
{% endset %}
{% if named_volumes | trim %}
volumes:
{{ named_volumes | trim('\n') }}
{% endif %}

# Bridges besides the default, each there to keep something away from
# something else.
{% if 'dockhand' in autolab_services_enabled or 'qr' in autolab_services_enabled or 'paradigm-tunnel' in autolab_services_enabled or 'cosmos' in autolab_services_enabled or 'novaflix' in autolab_services_enabled %}
networks:
{% endif %}
{% if 'dockhand' in autolab_services_enabled %}
  # Keep the unauthenticated backend off the other services' Docker network.
  # This dedicated bridge still permits Dockhand's outbound registry/Git calls.
  dockhand-control:
{% endif %}
{% if 'qr' in autolab_services_enabled or 'paradigm-tunnel' in autolab_services_enabled %}
  # What the Paradigm tunnel can reach: its connector and the containers meant
  # to be public, nothing else. An admin page, which has no login of its own,
  # is never on it.
  paradigm-public:
{% endif %}
{% if 'cosmos' in autolab_services_enabled %}
  # internal: true gives the API and database no route to the LAN or the
  # internet. The gateway joins it and cosmos-edge, which is how its published
  # port works: Docker will not publish a port from an internal-only container.
  cosmos-backend:
    internal: true
  cosmos-edge:
  # Only cosmos-vault-sync is on this one: its route to GitHub.
  cosmos-sync:
{% if 'hermes' in autolab_services_enabled %}
  # Hermes reaches the COSMOS API's /mcp here, and nothing else of COSMOS.
  # Internal: no route out through it.
  cosmos-agents:
    internal: true
{% endif %}
{% endif %}
{% if 'novaflix' in autolab_services_enabled %}
  # The database is on the internal network alone: no route to the LAN or the
  # internet. The gateways publish their ports through novaflix-edge, and the
  # server reaches TMDB through it.
  novaflix-backend:
    internal: true
  novaflix-edge:
{% endif %}
