# Managed by Ansible. The token is not an end-user credential.
map $http_x_autolab_dockhand_token $autolab_allowed {
    default 0;
    "{{ autolab_dockhand_proxy_token.content | b64decode | trim }}" 1;
}
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    location / {
        if ($autolab_allowed = 0) { return 403; }
        proxy_pass http://dockhand:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Autolab-Dockhand-Token "";
        proxy_read_timeout 3600s;
    }
}
