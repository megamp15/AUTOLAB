# Managed by Ansible — roles/container-services. Holds a client secret: root only.
{% set client_id = lookup('ansible.builtin.vars', 'autolab_services_' ~ app ~ '_oidc_client_id') %}
{% set client_secret = lookup('ansible.builtin.vars', 'autolab_services_' ~ app ~ '_oidc_client_secret') %}
{% set password_login = lookup('ansible.builtin.vars', 'autolab_services_' ~ app ~ '_password_login') | bool %}
{% set issuer = autolab_services_oidc_issuer %}
{% set public = lookup('ansible.builtin.vars', 'autolab_services_' ~ app ~ '_public_url') %}
{% if client_id | length > 0 %}
{% if app == 'tandoor' %}
SOCIAL_PROVIDERS=allauth.socialaccount.providers.openid_connect
SOCIALACCOUNT_PROVIDERS='{{ {'openid_connect': {'APPS': [{'provider_id': 'pocketid', 'name': 'Pocket ID', 'client_id': client_id, 'secret': client_secret, 'settings': {'server_url': issuer ~ '/.well-known/openid-configuration'}}]}} | to_json }}'
{% elif app == 'airtrail' %}
OAUTH_ENABLED=true
OAUTH_ISSUER_URL={{ issuer }}/.well-known/openid-configuration
OAUTH_CLIENT_ID={{ client_id }}
OAUTH_CLIENT_SECRET={{ client_secret }}
OAUTH_SCOPE=openid profile email
OAUTH_AUTO_REGISTER=true
OAUTH_BUTTON_TEXT=Log in with Pocket ID
OAUTH_HIDE_PASSWORD_FORM={{ 'false' if password_login else 'true' }}
{% elif app == 'linkace' %}
SSO_ENABLED=true
SSO_OIDC_ENABLED=true
SSO_OIDC_BASE_URL={{ issuer }}
SSO_OIDC_CLIENT_ID={{ client_id }}
SSO_OIDC_CLIENT_SECRET={{ client_secret }}
SSO_OIDC_SCOPES=openid profile email
SSO_REGISTRATION_ENABLED=true
SSO_REQUIRE_VERIFIED_EMAIL=true
REGULAR_LOGIN_DISABLED={{ 'false' if password_login else 'true' }}
{% elif app == 'sure' %}
OIDC_ISSUER={{ issuer }}
OIDC_CLIENT_ID={{ client_id }}
OIDC_CLIENT_SECRET={{ client_secret }}
OIDC_REDIRECT_URI={{ public }}/auth/openid_connect/callback
OIDC_BUTTON_LABEL=Sign in with Pocket ID
AUTH_JIT_MODE=create_and_link
{% endif %}
{% endif %}
