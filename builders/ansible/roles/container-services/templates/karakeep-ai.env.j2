# Managed by Ansible — roles/container-services. Holds an API key: root only.
# Empty without a key: Karakeep then saves and fetches, and skips tagging.
{% if autolab_services_karakeep_ai_api_key | length > 0 %}
OPENAI_API_KEY={{ autolab_services_karakeep_ai_api_key }}
OPENAI_BASE_URL={{ autolab_services_karakeep_ai_base_url }}
INFERENCE_TEXT_MODEL={{ autolab_services_karakeep_ai_text_model }}
INFERENCE_IMAGE_MODEL={{ autolab_services_karakeep_ai_image_model }}
INFERENCE_OUTPUT_SCHEMA=json
INFERENCE_ENABLE_AUTO_SUMMARIZATION=true
{% endif %}
