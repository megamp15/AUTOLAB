  # Novaflix's admin face: the same gateway image, run so that it also answers
  # /api/admin/ (who has an account, a new one, a password reset). Its name is
  # tailnet-only and behind the passkey, so those routes are never public.
  novaflix-admin:
    image: {{ autolab_services_novaflix_registry }}/novaflix-gateway:{{ autolab_services_novaflix_image_tag }}
    restart: unless-stopped
    cap_drop: [ALL]
    cap_add: [CHOWN, SETGID, SETUID, NET_BIND_SERVICE]
    security_opt:
      - no-new-privileges
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:80/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    labels:
      dockhand.tags: novaflix
      diun.enable: "false"
    environment:
      ADMIN_FACE: "1"
    depends_on:
      novaflix-server:
        condition: service_healthy
    ports:
      - "{{ autolab_services_tailscale_ip }}:{{ autolab_services_ports.novaflix_admin }}:80"
    networks:
      - novaflix-backend
      - novaflix-edge
