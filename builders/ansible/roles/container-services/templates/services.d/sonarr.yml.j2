  # Sonarr: finds and files TV series (shows, anime, dramas).
  # Runs as uid 1000 through the linuxserver image's own start-up, which needs
  # root for a moment to drop to it, so no cap_drop or no-new-privileges.
  # Settings are a SQLite database on this machine's disk; the media tree is
  # the share, mounted whole at /data so an import is a rename or a hardlink.
  # docs/gitops/media.md
  sonarr:
    image: {{ autolab_services_images.sonarr }}
    labels:
      dockhand.tags: sonarr
    restart: unless-stopped
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: "{{ autolab_timezone | default('UTC') }}"
      # The tailnet and the passkey in front are the gate (login: plugin).
      # Without this the app asks for a second password of its own.
      SONARR__AUTH__METHOD: External
    volumes:
      - {{ autolab_services_root }}/sonarr:/config
      - type: bind
        source: {{ autolab_services_media_root }}
        target: /data
        bind:
          create_host_path: false
    mem_limit: {{ autolab_services_memory.sonarr }}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8989/ping >/dev/null || exit 1"]
      start_period: 60s
      interval: 30s
      timeout: 6s
    ports:
      - "{{ autolab_services_tailscale_ip }}:{{ autolab_services_ports.sonarr }}:8989"
