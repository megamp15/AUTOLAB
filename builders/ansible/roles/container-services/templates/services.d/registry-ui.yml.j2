  registry-ui:
    image: {{ autolab_services_images.registry_ui }}
    restart: unless-stopped
    depends_on: [registry]
    # eznix86/docker-registry-ui (AGPL-3.0, run unmodified) reads the registry
    # itself, server-side, and keeps what it found in /app/data. So it uses the
    # compose network's name for the registry, and the browser only ever talks
    # to the UI. Its image pins a one-hour sync in its command; new tags show
    # within fifteen minutes instead.
    command: ["start", "-v", "--sync-interval=15m"]
    environment:
      REGISTRY_URL: "http://registry:5000"
      DISABLE_TAG_DELETION: "{{ (not (autolab_services_registry_delete_enabled | bool)) | string | lower }}"
      SHOW_USAGE_BAR: "true"
    volumes:
      - registry-ui-data:/app/data
    ports:
      - "{{ autolab_services_tailscale_ip }}:{{ autolab_services_ports.registry_ui }}:3000"
