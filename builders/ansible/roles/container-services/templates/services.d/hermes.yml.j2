  # Hermes Agent: the owner's WhatsApp agent. Outbound only (WhatsApp over the
  # Baileys bridge, the model provider, GitHub), so no port and no Traefik
  # route. The gateway's own API server stays off. It runs as the operator
  # account over two bind mounts: its state and the vault checkout. No Docker
  # socket: an agent with a shell does not also get the daemon.
  # See docs/gitops/hermes.md.
  hermes:
    image: {{ autolab_services_images.hermes }}
    restart: unless-stopped
    command: ["gateway", "run"]
    security_opt:
      - no-new-privileges
    env_file:
      - path: {{ autolab_services_root }}/hermes/data/.env
        required: true
    environment:
      # The image remaps its internal user to these at start, so files it
      # writes stay the operator's on the host.
      HERMES_UID: "{{ ansible_facts.getent_passwd.megamp15[1] }}"
      HERMES_GID: "{{ ansible_facts.getent_group.megamp15[1] }}"
      TZ: "{{ autolab_services_timezone }}"
      GIT_AUTHOR_NAME: "{{ autolab_services_hermes_git_name }}"
      GIT_AUTHOR_EMAIL: "{{ autolab_services_hermes_git_email }}"
      GIT_COMMITTER_NAME: "{{ autolab_services_hermes_git_name }}"
      GIT_COMMITTER_EMAIL: "{{ autolab_services_hermes_git_email }}"
    volumes:
      - {{ autolab_services_root }}/hermes/data:/opt/data
      - {{ autolab_services_root }}/hermes/vault:/workspace/vault
    mem_limit: {{ autolab_services_hermes_memory }}
    cpus: {{ autolab_services_hermes_cpus }}
    healthcheck:
      test: ["CMD-SHELL", "hermes gateway status >/dev/null 2>&1 || exit 1"]
      start_period: 90s
      interval: 60s
      timeout: 15s
      retries: 3
