# Managed by Ansible — roles/ingress. Static configuration; a change here is
# a restart, which the role notifies.
entryPoints:
  # cloudflared's door: plain HTTP on the compose network only. TLS ended at
  # Cloudflare; tell upstreams the truth about the scheme.
  web:
    address: ":80"
    forwardedHeaders:
      insecure: true
{% if autolab_ingress_tailnet_side | bool %}
  # The tailnet's doors: published on this host's tailnet address only.
  # HTTP exists to redirect; nothing is served on it.
  tailnet-http:
    address: ":8080"
    http:
      # ":443", not the entrypoint's name: the container listens on 8443
      # and the host publishes it as 443, and a redirect by name would send
      # the browser to the container's port.
      redirections:
        entryPoint:
          to: ":443"
          scheme: https
          permanent: true
  tailnet-https:
    address: ":8443"
    # Traefik v3 gives up on a request whose body takes longer than 60s to
    # read. A browser never notices; a container registry behind this door
    # does, the first time a layer bigger than a minute's upload is pushed.
    transport:
      respondingTimeouts:
        readTimeout: "{{ autolab_ingress_tailnet_read_timeout }}"
{% endif %}
{% if autolab_ingress_metrics_port | int > 0 %}
  # Prometheus metrics, published on the host's loopback only for the local
  # agent (autolab_obs_extra_scrapes). Not routed, not on the tailnet.
  metrics:
    address: ":{{ autolab_ingress_metrics_port }}"
{% endif %}

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

{% if autolab_ingress_tailnet_side | bool %}
# One wildcard certificate for *.{{ autolab_ingress_internal_label }}.{{ autolab_ingress_zone }} through the DNS
# challenge: Let's Encrypt never reaches horizon, it reads a TXT record
# Traefik writes with the DNS-only token. Renewed by Traefik, kept in acme.json.
certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ autolab_ingress_acme_email }}
      storage: /letsencrypt/acme.json
      dnsChallenge:
        provider: cloudflare
        resolvers: ["1.1.1.1:53", "1.0.0.1:53"]
{% endif %}

# The homepage cannot run an OIDC login itself. This plugin does it for any
# router that names its middleware. Fetched from the plugin registry at start.
experimental:
  plugins:
    traefik-oidc-auth:
      moduleName: github.com/sevensolutions/traefik-oidc-auth
      version: {{ autolab_ingress_oidc_plugin_version }}

api:
  dashboard: false

log:
  level: INFO
{% if autolab_ingress_access_log_format == 'json' %}
# JSON so the log pipeline can filter on status, router and duration without
# parsing the common log format back apart.
accessLog:
  format: json
{% else %}
accessLog: {}
{% endif %}
{% if autolab_ingress_metrics_port | int > 0 %}

# Request counts and latency per entrypoint, router and service.
metrics:
  prometheus:
    entryPoint: metrics
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true
{% endif %}
{% if autolab_ingress_otlp_traces_endpoint | length > 0 %}

# A span for every request, sent to the trace backend over OTLP/HTTP. Traefik
# starts the trace (or joins the caller's), and the upstream app continues it
# from the traceparent header Traefik forwards.
tracing:
  serviceName: traefik
  sampleRate: {{ autolab_ingress_trace_sample_rate }}
  otlp:
    http:
      endpoint: "{{ autolab_ingress_otlp_traces_endpoint }}"
{% endif %}
