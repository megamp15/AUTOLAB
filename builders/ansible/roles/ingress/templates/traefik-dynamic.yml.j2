# Managed by Ansible — roles/ingress. Watched: edits here reload without a
# restart. A hostname without a router here gets Traefik's 404, never a
# service — the tunnel hands every public hostname to this file, and the
# tailnet's wildcard record hands every internal name to it too.
{% set zone = autolab_ingress_zone %}
{% set auth_host = autolab_ingress_hostnames.auth ~ '.' ~ zone %}
{% set home_host = autolab_ingress_hostnames.home ~ '.' ~ autolab_ingress_internal_label ~ '.' ~ zone %}
{% set plugin_on = autolab_ingress_traefik_client_id | length > 0 %}
{% set tailnet_on = autolab_ingress_tailnet_side | bool %}
{% set lab = autolab_ingress_internal_label ~ '.' ~ zone %}
http:
  routers:
    # --- public, through the tunnel ---------------------------------------
    auth:
      rule: "Host(`{{ auth_host }}`)"
      entryPoints: [web]
      service: pocket-id
{% for name, route in autolab_ingress_public_routes.items() %}
    public-{{ name }}:
      rule: "Host(`{{ name }}.{{ zone }}`)"
      entryPoints: [web]
      service: public-{{ name }}
{% endfor %}
{% if tailnet_on %}
    # --- tailnet only, HTTPS with the wildcard certificate ------------------
{%   for name, route in autolab_ingress_internal_routes.items() %}
{%     if route.login not in ['plugin', 'admin'] or plugin_on %}
    lab-{{ name }}:
      rule: "Host(`{{ name }}.{{ lab }}`)"
      entryPoints: [tailnet-https]
{%       set chain = (['oidc'] if route.login == 'plugin' else ['oidc-admin'] if route.login == 'admin' else []) + (['lab-' ~ name ~ '-token'] if route.token_header is defined else []) %}
{%       if chain %}
      middlewares: {{ chain | to_json }}
{%       endif %}
      service: lab-{{ name }}
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ lab }}"
            sans: ["*.{{ lab }}"]
{%     endif %}
{%   endfor %}
{%   for name in autolab_ingress_service_hosts %}
{%     set svc = autolab_service_catalog[name] %}
{%     if svc.port is defined and (svc.login not in ['plugin', 'admin'] or plugin_on) %}
    lab-{{ name }}:
      rule: "Host(`{{ name }}.{{ lab }}`)"
      entryPoints: [tailnet-https]
{%       if svc.login == 'admin' %}
      middlewares: [oidc-admin, dockhand-upstream]
{%       elif svc.login == 'plugin' %}
      middlewares: [oidc]
{%       endif %}
      service: lab-{{ name }}
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ lab }}"
            sans: ["*.{{ lab }}"]
{%     endif %}
{%   endfor %}
{% endif %}

  services:
{% for name, route in autolab_ingress_public_routes.items() %}
    public-{{ name }}:
      loadBalancer:
        servers:
          - url: "{{ route.upstream }}"
{% endfor %}
    pocket-id:
      loadBalancer:
        servers:
          - url: "http://pocket-id:1411"
{% if tailnet_on %}
{%   for name, route in autolab_ingress_internal_routes.items() %}
{%     if route.login not in ['plugin', 'admin'] or plugin_on %}
    lab-{{ name }}:
      loadBalancer:
{%       if route.insecure_upstream | default(false) %}
        serversTransport: self-signed-upstream
{%       endif %}
        servers:
          - url: "{{ route.upstream }}"
{%     endif %}
{%   endfor %}
{%   for name in autolab_ingress_service_hosts %}
{%     set svc = autolab_service_catalog[name] %}
{%     if svc.port is defined and (svc.login not in ['plugin', 'admin'] or plugin_on) %}
    lab-{{ name }}:
      loadBalancer:
        servers:
          - url: "http://{{ autolab_ingress_service_hosts[name] }}:{{ svc.port }}"
{%     endif %}
{%   endfor %}

  # Proxmox, PBS and UGOS present their own self-signed certificates on the
  # tailnet. The browser sees Traefik's real one; this hop is tailnet to
  # tailnet, so identity is the tailnet's job and verification is skipped.
  serversTransports:
    self-signed-upstream:
      insecureSkipVerify: true
{% endif %}
{% if plugin_on %}

  # One login for internal services. The callback is private too, and the
  # cookie remains scoped to the zone so existing internal services share it.
  middlewares:
{% for middleware, groups in [('oidc', autolab_ingress_homepage_groups), ('oidc-admin', ['admins'])] %}
    {{ middleware }}:
      plugin:
        traefik-oidc-auth:
          Secret: "{{ autolab_ingress_oidc_plugin_secret }}"
          CallbackUri: "https://{{ home_host }}/oidc/callback"
          Provider:
            Url: "https://{{ auth_host }}/"
            ClientId: "{{ autolab_ingress_traefik_client_id }}"
            ClientSecret: "{{ autolab_ingress_traefik_client_secret }}"
          Scopes: ["openid", "profile", "email", "groups"]
          SessionCookie:
            Domain: ".{{ zone }}"
            MaxAge: {{ autolab_ingress_session_max_age }}
          Authorization:
            AssertClaims:
              - Name: groups
                AnyOf: {{ groups | to_json }}
{% endfor %}
{% for name, route in autolab_ingress_internal_routes.items() if route.token_header is defined %}
    lab-{{ name }}-token:
      headers:
        customRequestHeaders:
          {{ route.token_header }}: {{ route.token | to_json }}
{% endfor %}
{% if 'dockhand' in autolab_ingress_services %}
    dockhand-upstream:
      headers:
        customRequestHeaders:
          X-Autolab-Dockhand-Token: "{{ autolab_ingress_dockhand_token.content | b64decode | trim }}"
{% endif %}
{% endif %}
