# Managed by Ansible — roles/ingress. The DNS-only Cloudflare token for the
# certificate's DNS challenge. It can edit this zone's records and nothing
# else, which is all a token on the exposed machine should be able to do.
{% if autolab_ingress_tailnet_side | bool %}
CF_DNS_API_TOKEN={{ autolab_ingress_acme_dns_token }}
{% endif %}
