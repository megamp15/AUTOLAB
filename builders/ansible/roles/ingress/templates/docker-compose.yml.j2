# Managed by Ansible — roles/ingress. Local edits are overwritten.
#
# No service publishes a port, except cloudflared's metrics on loopback for
# the local agent. cloudflared dials Cloudflare outbound and hands
# every request to Traefik over this compose network; Traefik reaches the
# services it routes over the tailnet; Pocket ID is only ever reached through
# Traefik. The host firewall sees nothing inbound because nothing is.
services:
  cloudflared:
    image: {{ autolab_ingress_images.cloudflared }}
    restart: unless-stopped
    env_file: cloudflared.env
    # --no-autoupdate: the image tag is the version. Metrics on the compose
    # network only, for the tunnel alert.
    command: tunnel --no-autoupdate --metrics 0.0.0.0:2000 run
    # The one published port, and only on loopback: Alloy on this host scrapes
    # the connector's metrics. Nothing off the host can reach it.
    ports:
      - "127.0.0.1:2000:2000"
    depends_on: [traefik]

  traefik:
    image: {{ autolab_ingress_images.traefik }}
    restart: unless-stopped
    env_file: traefik.env
    volumes:
      - ./traefik/traefik.yml:/etc/traefik/traefik.yml:ro
      - ./traefik/dynamic:/etc/traefik/dynamic:ro
      - ./traefik/acme:/letsencrypt
{% if autolab_ingress_tailnet_side | bool %}
    # The tailnet's doors, on the tailnet address only. Docker's iptables
    # rules run ahead of ufw's, so binding 0.0.0.0 would reach the LAN.
    ports:
      - "{{ autolab_ingress_tailscale_ip }}:80:8080"
      - "{{ autolab_ingress_tailscale_ip }}:443:8443"
{% endif %}
    # Tailscale's resolver, so `jwst.<tailnet>` resolves inside the container
    # the way it does on the host. Docker's embedded DNS would otherwise fall
    # back to the host's upstream servers, which know nothing about MagicDNS.
    dns:
      - 100.100.100.100
    dns_search:
      - {{ autolab_ingress_tailnet_domain }}
    depends_on: [pocket-id]

  pocket-id:
    image: {{ autolab_ingress_images.pocket_id }}
    restart: unless-stopped
    env_file: pocket-id.env
    volumes:
      - ./pocket-id:/app/data
    healthcheck:
      test: ["CMD", "/app/pocket-id", "healthcheck"]
      interval: 1m30s
      timeout: 5s
      retries: 2
      start_period: 10s
