[Unit]
Description=Autolab ingress stack — start once the tailnet address exists
Wants=tailscaled.service docker.service
After=tailscaled.service docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Traefik's upstreams are tailnet names; dockerd would restart the stack
# before tailscaled is up. This unit owns the boot path, the restart policy
# stays the crash backstop, and `compose up -d` is a no-op when it already runs.
TimeoutStartSec=180
Restart=on-failure
RestartSec=10
ExecStartPre=/bin/sh -c 'until ip -4 addr show dev tailscale0 | grep -qF "{{ autolab_ingress_tailscale_ip }}/"; do sleep 2; done'
ExecStart=/usr/bin/docker compose --project-directory {{ autolab_ingress_root }} up -d

[Install]
WantedBy=multi-user.target
