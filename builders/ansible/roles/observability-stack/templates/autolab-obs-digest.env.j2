# Managed by Ansible — roles/observability-stack. Mode 0600; contains a token.
PVE_TOKEN_ID={{ autolab_obs_pve_token_id }}
PVE_VERIFY_SSL={{ autolab_obs_pve_verify_ssl | bool | lower }}
{#- One object per node. Single-quoted: systemd and sh both keep the JSON's
    double quotes inside it, and a token secret never contains a quote. #}
{% set ns = namespace(nodes=[]) %}
{% for node in autolab_obs_pve_nodes %}
{%   set ns.nodes = ns.nodes + [{'name': node.name, 'host': node.host, 'secret': node.token_secret,
                                 'ui': autolab_obs_lab_url.format(name=node.name, raw='https://' ~ node.host ~ ':8006')}] %}
{% endfor %}
PVE_NODES='{{ ns.nodes | to_json }}'
PROMETHEUS_URL=http://{{ autolab_tailscale_fqdn }}:{{ autolab_obs_prometheus_port }}
GRAFANA_URL=http://{{ autolab_tailscale_fqdn }}:{{ autolab_obs_grafana_port }}
NTFY_URL={{ autolab_obs_ntfy_url }}
NTFY_TOPIC={{ autolab_obs_ntfy_topic }}
BACKUP_STORAGE={{ autolab_obs_digest_backup_storage }}
STALE_HOURS={{ autolab_obs_digest_stale_hours }}
