# Managed by Ansible — roles/observability-stack.
[Unit]
Description=Homepage status.json from Proxmox, PBS and Grafana
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/autolab/obs-digest.env
EnvironmentFile=-/etc/autolab/obs-digest-pbs.env
ExecStart=/usr/local/bin/autolab-obs-digest --status {{ autolab_obs_root }}/homepage/site/status.json
