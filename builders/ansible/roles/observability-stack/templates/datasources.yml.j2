# Managed by Ansible — roles/observability-stack. Local edits are overwritten.
apiVersion: 1

datasources:
  - name: Prometheus
    # Explicit uid: provisioned alert rules reference datasources by uid, and a
    # generated one would change if the datasource were ever recreated.
    uid: autolab-prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    jsonData:
      timeInterval: {{ autolab_obs_scrape_interval | default('15s') }}

  - name: Loki
    uid: autolab-loki
    type: loki
    access: proxy
    url: http://loki:{{ autolab_obs_loki_port }}
{% if autolab_obs_tempo_enabled | bool %}

  # Traces. A span links to the logs around it (same service, a few minutes
  # either side) and to the span metrics Tempo writes into Prometheus.
  - name: Tempo
    uid: autolab-tempo
    type: tempo
    access: proxy
    url: http://tempo:3200
    jsonData:
      streamingEnabled:
        search: true
        metrics: true
      nodeGraph:
        enabled: true
      serviceMap:
        datasourceUid: autolab-prometheus
      tracesToLogsV2:
        datasourceUid: autolab-loki
        spanStartTimeShift: "-5m"
        spanEndTimeShift: "5m"
        filterByTraceID: false
        filterBySpanID: false
        customQuery: true
        query: '{service=~".*${__span.tags["service.name"]}.*"}'
      tracesToMetrics:
        datasourceUid: autolab-prometheus
{% endif %}
