# Managed by Ansible — roles/observability-stack. Local edits are overwritten.
#
# Tempo in one process: OTLP in, blocks on local disk, queried by Grafana on
# the compose network. The metrics generator turns spans into request-rate,
# error and latency series (span metrics) and caller -> callee edges (service
# graph) and writes them to Prometheus, so traced services get RED metrics
# without exporting any of their own.
#
# Tempo 3: there are no ingesters. In one process the distributor hands spans
# to the live store (recent traces, search and TraceQL metrics) and the
# metrics generator directly, no Kafka. Retention belongs to the backend
# scheduler and worker. A trace shows in search once it is complete, about a
# minute after its last span; lookup by ID works at once.
stream_over_http_enabled: true

server:
  http_listen_port: 3200
  log_level: warn

distributor:
  receivers:
    otlp:
      protocols:
        http:
          endpoint: 0.0.0.0:4318
        grpc:
          endpoint: 0.0.0.0:4317

backend_scheduler:
  provider:
    compaction:
      compaction:
        block_retention: {{ autolab_obs_tempo_retention }}

backend_worker:
  compaction:
    block_retention: {{ autolab_obs_tempo_retention }}

metrics_generator:
  registry:
    external_labels:
      source: tempo
  storage:
    path: /var/tempo/generator/wal
    remote_write:
      - url: http://prometheus:9090/api/v1/write
        send_exemplars: true
{% if autolab_obs_tempo_span_dimensions | length > 0 %}
  # Span attributes promoted to labels on the span metrics, e.g. the HTTP
  # status code, so "requests that returned 401" is a series. Each one
  # multiplies the series count: keep them low-cardinality.
  processor:
    span_metrics:
      dimensions: {{ autolab_obs_tempo_span_dimensions | to_json }}
{% endif %}

storage:
  trace:
    backend: local
    wal:
      path: /var/tempo/wal
    local:
      path: /var/tempo/blocks

overrides:
  defaults:
    metrics_generator:
      processors: [service-graphs, span-metrics]
