# Managed by Ansible — roles/observability-stack.
[Unit]
Description=Backup ages from PBS into a textfile for Alloy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/autolab/obs-digest.env
EnvironmentFile=-/etc/autolab/obs-digest-pbs.env
ExecStart=/usr/local/bin/autolab-obs-digest --metrics
