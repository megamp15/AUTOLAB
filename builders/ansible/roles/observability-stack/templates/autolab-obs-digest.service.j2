# Managed by Ansible — roles/observability-stack.
[Unit]
Description=Morning digest to ntfy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/autolab/obs-digest.env
# Written by the backup playbook once PBS exists; optional until then.
EnvironmentFile=-/etc/autolab/obs-digest-pbs.env
# Written by the role once Grafana needs a login; optional until then.
EnvironmentFile=-/etc/autolab/obs-digest-grafana.env
ExecStart=/usr/local/bin/autolab-obs-digest
