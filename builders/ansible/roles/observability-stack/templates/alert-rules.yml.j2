# Managed by Ansible — roles/observability-stack. Local edits are overwritten.
#
# Alert rules as files, for the same reason dashboards are: a rule that exists
# only in a UI cannot be reviewed, and is lost with the volume it lives in.
#
# Thresholds are deliberately not tight. An alert that fires routinely is an
# alert people learn to close without reading, which is worse than no alert.
#
# Rules are loaded at Grafana start; a changed file notifies a restart.
# noDataState is OK on every rule, deliberately. These queries return series
# only when something is wrong, so an empty result is the healthy case —
# Grafana's default of treating no data as a problem fires them exactly when
# nothing is. Genuinely missing metrics are caught by "Agent is not reporting",
# which is the rule whose whole job that is; duplicating it here would mean two
# alerts for one fault.
#
# Grafana annotations below use Go templating, which shares its delimiters with
# Jinja. They sit inside raw blocks so Ansible passes them through untouched —
# without that, $labels is invalid Jinja and fails the render. (This comment
# deliberately spells out no delimiters: Jinja parses comments too.)
apiVersion: 1

groups:
  - orgId: 1
    name: autolab
    folder: Autolab
    interval: 1m
    rules:
      - uid: autolab-guest-down
        title: Guest is stopped but set to start on boot
        condition: THRESHOLD
        for: 5m
        noDataState: OK
        execErrState: Error
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}{{ $labels.name }} ({{ $labels.id }}) is stopped{% endraw %}"
          description: "Proxmox reports this guest as stopped, but it is configured to start on boot."
        data:
          - refId: QUERY
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: autolab-prometheus
            model:
              refId: QUERY
              instant: true
              editorMode: code
              # `pve_up == 0` filters to stopped guests but keeps the value it
              # matched, which is 0 — so the threshold below, gt 0.5, could never
              # fire. The rule selected the right guest and then called it
              # healthy. Selecting on onboot instead returns 1, which is both
              # truthy for the threshold and the thing being asserted: this guest
              # is supposed to be running.
              # The join is for the annotation, not the logic: without it the only
              # identifier on these series is `id`, so the notification read
              # "qemu/102 is stopped" and left you to work out which VM that is.
              expr: '(pve_onboot_status{id=~"qemu/.*"} == 1 unless on(id) pve_up == 1) * on(id) group_left(name) max by (id, name) (pve_guest_info)'
          - refId: THRESHOLD
            datasourceUid: __expr__
            model:
              refId: THRESHOLD
              type: threshold
              expression: QUERY
              conditions:
                - evaluator:
                    type: gt
                    params: [0.5]

      - uid: autolab-agent-silent
        title: Agent is not reporting
        condition: THRESHOLD
        for: 10m
        noDataState: OK
        execErrState: Error
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}{{ $labels.name }} is running but sending no metrics{% endraw %}"
          description: "Proxmox reports the guest as running, so this is the agent or the network, not a stopped VM."
        data:
          - refId: QUERY
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: autolab-prometheus
            model:
              refId: QUERY
              instant: true
              editorMode: code
              # max by (id, name): pve_guest_info carries a `tags` label, and a
              # freshly cloned VM briefly reports the template's tags before
              # OpenTofu sets its own. Both series then sit in the lookback
              # window, group_left sees two right-hand matches for one id, and
              # the whole query fails with "many-to-many matching not allowed" —
              # taking the rule into Error rather than firing or clearing.
              # Aggregating away the volatile labels leaves one series per guest.
              #
              # Guests that opted out of the agent are excluded by name. Without
              # this the rule fires forever for a machine that is behaving
              # exactly as configured, and an alert that is permanently wrong
              # teaches you to ignore the channel it arrives on.
              #
              # The list comes from the same machines map that skipped the
              # install, so the two cannot drift: one declaration, both effects.
              #
              # Tenant guests are held to the same rule. They ship over the
              # bridge to this host's ingest ports, and a tenant VM that has
              # gone quiet is exactly what the provider needs to hear about.
              # The one gap: a tenant that sets agent = false in its own map is
              # invisible to this inventory, so the rule fires for it — opting
              # a tenant guest out means telling the provider, not the file.
              expr: '(pve_up{id=~"qemu/.*"} == 1) * on(id) group_left(name) max by (id, name) (pve_guest_info{template="0"{% if autolab_obs_unmonitored_guests %}, name!~"{{ autolab_obs_unmonitored_guests | join('|') }}"{% endif %}}) unless on(name) label_replace(node_uname_info, "name", "$1", "instance", "(.+)")'
          - refId: THRESHOLD
            datasourceUid: __expr__
            model:
              refId: THRESHOLD
              type: threshold
              expression: QUERY
              conditions:
                - evaluator:
                    type: gt
                    params: [0.5]

      - uid: autolab-disk-full
        title: Root filesystem almost full
        condition: THRESHOLD
        for: 15m
        noDataState: OK
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}{{ $labels.instance }} root filesystem is {{ printf \{% endraw %}"%.0f\" $value }}% full"
          description: "The Debian template root partition cannot be grown in place, so freeing space is the only remedy."
        data:
          - refId: QUERY
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: autolab-prometheus
            model:
              refId: QUERY
              instant: true
              editorMode: code
              expr: '100 - (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"} * 100)'
          - refId: THRESHOLD
            datasourceUid: __expr__
            model:
              refId: THRESHOLD
              type: threshold
              expression: QUERY
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ autolab_obs_alert_disk_pct }}]

      - uid: autolab-memory-high
        title: Memory nearly exhausted
        condition: THRESHOLD
        for: 15m
        noDataState: OK
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}{{ $labels.instance }} memory is {{ printf \{% endraw %}"%.0f\" $value }}% used"
          description: "Sustained pressure. A metrics backend that starts swapping stops being able to explain anything."
        data:
          - refId: QUERY
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: autolab-prometheus
            model:
              refId: QUERY
              instant: true
              editorMode: code
              expr: '100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)'
          - refId: THRESHOLD
            datasourceUid: __expr__
            model:
              refId: THRESHOLD
              type: threshold
              expression: QUERY
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ autolab_obs_alert_memory_pct }}]

      - uid: autolab-pve-storage-full
        title: Proxmox storage almost full
        condition: THRESHOLD
        for: 15m
        noDataState: OK
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}{{ $labels.id }} is {{ printf \{% endraw %}"%.0f\" $value }}% full"
          description: "No guest can be created or snapshotted once this fills, and the failure surfaces far from here."
        data:
          - refId: QUERY
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: autolab-prometheus
            model:
              refId: QUERY
              instant: true
              editorMode: code
              expr: 'pve_disk_usage_bytes{id=~"storage/.*"} / pve_disk_size_bytes{id=~"storage/.*"} * 100'
          - refId: THRESHOLD
            datasourceUid: __expr__
            model:
              refId: THRESHOLD
              type: threshold
              expression: QUERY
              conditions:
                - evaluator:
                    type: gt
                    params: [{{ autolab_obs_alert_pve_storage_pct }}]

      # The two backup rules read the digest's textfile through
      # last_over_time so they judge the collector's last facts even after the
      # file is gone (timer stopped and file removed, textfile dir cleared,
      # stack host rebuilt). Without it, absence forgets which guests the job
      # excludes and pages for all of them at once, and the stale rule — whose
      # metric then no longer exists — never fires to say why.
      - uid: autolab-backup-missing
        title: Backup is missing
        condition: THRESHOLD
        for: 30m
        noDataState: OK
        execErrState: Error
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}{{ $labels.name }} has no backup newer than {% endraw %}{{ autolab_obs_alert_backup_max_age_hours }}h"
          description: "A running guest the nightly should cover has no recent backup on PBS — job disabled, node off at 02:00, ark or the NAS unreachable, or the guest was never backed up. Exclusions come from the job itself."
        data:
          - refId: QUERY
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: autolab-prometheus
            model:
              refId: QUERY
              instant: true
              editorMode: code
              # Running, non-template guests (same shape as the agent rule),
              # minus those the vzdump job excludes on purpose, minus those
              # with a backup younger than the threshold. What remains is a
              # guest that should have been backed up and was not — stale and
              # never-backed-up alike. The backup facts come from the stack
              # host's collector (autolab-obs-digest --metrics), which reads
              # PBS with a read-only token.
              expr: '((pve_up{id=~"qemu/.*"} == 1) * on(id) group_left(name) max by (id, name) (pve_guest_info{template="0"})) unless on(name) (max by (name) (last_over_time(autolab_backup_excluded[7d])) == 1) unless on(name) ((time() - max by (name) (last_over_time(autolab_backup_last_seconds[7d]))) < {{ autolab_obs_alert_backup_max_age_hours }} * 3600)'
          - refId: THRESHOLD
            datasourceUid: __expr__
            model:
              refId: THRESHOLD
              type: threshold
              expression: QUERY
              conditions:
                - evaluator:
                    type: gt
                    params: [0.5]

      - uid: autolab-backup-collector-stale
        title: Backup collector is stale
        condition: THRESHOLD
        for: 15m
        noDataState: OK
        execErrState: Error
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}The backup collector last wrote {{ printf \{% endraw %}"%.0f\" $value }} minutes ago"
          description: "The stack host's PBS collector has not refreshed the backup ages. While it is stale, 'Backup is missing' judges old facts — fix the collector before trusting either silence or a page."
        data:
          - refId: QUERY
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: autolab-prometheus
            model:
              refId: QUERY
              instant: true
              editorMode: code
              expr: '(time() - max(last_over_time(autolab_backup_collector_timestamp_seconds[7d]))) / 60'
          - refId: THRESHOLD
            datasourceUid: __expr__
            model:
              refId: THRESHOLD
              type: threshold
              expression: QUERY
              conditions:
                - evaluator:
                    type: gt
                    params: [60]
