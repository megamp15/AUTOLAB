                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS}"
                      },
                      "spec": {
                        "expr": "pve_memory_size_bytes{id=~\"node/.*\"}",
                        "legendFormat": "total {{id}}"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes",
                  "custom": {
                    "fillOpacity": 8,
                    "lineWidth": 2
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Guests stopped",
          "links": [],
