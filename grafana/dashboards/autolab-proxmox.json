{
  "apiVersion": "dashboard.grafana.app/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "autolab-proxmox"
  },
  "spec": {
    "title": "Autolab \u2014 Proxmox",
    "description": "Hypervisor view from the read-only API token. Shows what Proxmox believes, which is deliberately independent of what each guest's agent reports.",
    "tags": [
      "autolab",
      "provisioned",
      "proxmox"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "DS",
          "type": "datasource",
          "query": "prometheus",
          "current": {},
          "hide": 0
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Guests running",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "count(pve_up{id=~\"qemu/.*\"} == 1)",
            "refId": "A",
            "legendFormat": "running"
          }
        ],
        "description": "Counts guests Proxmox reports as up, independent of whether their agent reports."
      },
      {
        "id": 2,
        "title": "Guests stopped",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 4,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "count(pve_up{id=~\"qemu/.*\"} == 0) or vector(0)",
            "refId": "A",
            "legendFormat": "stopped"
          }
        ]
      },
      {
        "id": 3,
        "title": "Guests never backed up",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 8,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "pve_not_backed_up_total or vector(0)",
            "refId": "A",
            "legendFormat": "no backup"
          }
        ],
        "description": "A guest with no backup is a guest you cannot restore. Counts, not a threshold."
      },
      {
        "id": 4,
        "title": "Node uptime",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            },
            "unit": "s"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "pve_uptime_seconds{id=~\"node/.*\"}",
            "refId": "A",
            "legendFormat": "{{id}}"
          }
        ]
      },
      {
        "id": 5,
        "title": "Subscription status",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "pve_subscription_status",
            "refId": "A",
            "legendFormat": "status"
          }
        ],
        "description": "0 means no subscription, which is expected on a no-subscription lab host."
      },
      {
        "id": 10,
        "title": "Node CPU",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            },
            "unit": "percent"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "pve_cpu_usage_ratio{id=~\"node/.*\"} * 100",
            "refId": "A",
            "legendFormat": "{{id}}"
          }
        ]
      },
      {
        "id": 11,
        "title": "Node memory",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            },
            "unit": "bytes"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "pve_memory_usage_bytes{id=~\"node/.*\"}",
            "refId": "A",
            "legendFormat": "used {{id}}"
          },
          {
            "expr": "pve_memory_size_bytes{id=~\"node/.*\"}",
            "refId": "B",
            "legendFormat": "total {{id}}"
          }
        ]
      },
      {
        "id": 20,
        "title": "Guest CPU",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            },
            "unit": "percent"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "pve_cpu_usage_ratio{id=~\"qemu/.*\"} * 100 * on(id) group_left(name) pve_guest_info",
            "refId": "A",
            "legendFormat": "{{name}}"
          }
        ]
      },
      {
        "id": 21,
        "title": "Guest memory used",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            },
            "unit": "bytes"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "pve_memory_usage_bytes{id=~\"qemu/.*\"} * on(id) group_left(name) pve_guest_info",
            "refId": "A",
            "legendFormat": "{{name}}"
          }
        ]
      },
      {
        "id": 30,
        "title": "Guest disk read",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 20
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            },
            "unit": "Bps"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(pve_disk_read_bytes_total{id=~\"qemu/.*\"}[5m]) * on(id) group_left(name) pve_guest_info",
            "refId": "A",
            "legendFormat": "{{name}}"
          }
        ]
      },
      {
        "id": 31,
        "title": "Guest disk write",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 20
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            },
            "unit": "Bps"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(pve_disk_written_bytes_total{id=~\"qemu/.*\"}[5m]) * on(id) group_left(name) pve_guest_info",
            "refId": "A",
            "legendFormat": "{{name}}"
          }
        ]
      },
      {
        "id": 40,
        "title": "Guest network received",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 28
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            },
            "unit": "Bps"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(pve_network_receive_bytes_total{id=~\"qemu/.*\"}[5m]) * on(id) group_left(name) pve_guest_info",
            "refId": "A",
            "legendFormat": "{{name}}"
          }
        ]
      },
      {
        "id": 41,
        "title": "Guest network transmitted",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 28
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            },
            "unit": "Bps"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(pve_network_transmit_bytes_total{id=~\"qemu/.*\"}[5m]) * on(id) group_left(name) pve_guest_info",
            "refId": "A",
            "legendFormat": "{{name}}"
          }
        ]
      },
      {
        "id": 50,
        "title": "Storage used",
        "type": "bargauge",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 36
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            },
            "unit": "percent"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "pve_disk_usage_bytes{id=~\"storage/.*\"} / pve_disk_size_bytes{id=~\"storage/.*\"} * 100",
            "refId": "A",
            "legendFormat": "{{id}}"
          }
        ],
        "description": "No guest can be created or snapshotted once a datastore fills.",
        "options": {
          "displayMode": "gradient",
          "orientation": "horizontal"
        }
      },
      {
        "id": 51,
        "title": "Storage free",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 36
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 8,
              "lineWidth": 2
            },
            "unit": "bytes"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "pve_disk_size_bytes{id=~\"storage/.*\"} - pve_disk_usage_bytes{id=~\"storage/.*\"}",
            "refId": "A",
            "legendFormat": "{{id}}"
          }
        ]
      }
    ],
    "links": []
  }
}
