{
  "name": "__app__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev:server": "node --env-file=.env --import tsx --watch src/server/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fastify": "^5.0.0",
    "lucide-react": "^1.77.0",
    "pg": "^8.0.0",
    "radix-ui": "^1.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
