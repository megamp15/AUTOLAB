# Local development. Copy to .env.
DB_PASSWORD=__app__-dev-password
DB_PORT=__DB_PORT__
DB_PUBLISH_PORT=__DB_PORT__
# The address Vite listens on; set it to this computer's Wi-Fi IP to open the app on a phone.
VITE_HOST=127.0.0.1

# Optional: other ways to sign in. Each only signs in an email that already has an account.
# The provider must be given this redirect address: <PUBLIC_URL>/api/auth/oidc/<google|pocketid>/callback
# PUBLIC_URL=http://127.0.0.1:__WEB_PORT__
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# POCKETID_ISSUER=
# POCKETID_CLIENT_ID=
# POCKETID_CLIENT_SECRET=
