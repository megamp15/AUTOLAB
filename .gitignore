# Never commit host secrets or local overrides
/etc/default/proxmox-network.env
**/proxmox-network.env
*.env.local
.env
.env.*
*.tfvars
# Machine maps are committed desired state — every stack's, not just the
# first one. A tenant stack whose map is ignored merges green and applies
# nothing, which is how the hypervisor inventory once went missing too.
!infra/stacks/*/machines.auto.tfvars
*.tfvars.json
!*.tfvars.example
*.pkrvars.hcl
!*.pkrvars.example
*.tfstate
*.tfstate.*
*.tfplan
plan.out
.terraform/
tofu.env
ssh-keys/
*.pem
*.key
builders/ansible/inventories/**/hosts.yml
# The hypervisor inventory is the exception, and is tracked on purpose. Every
# other inventory is generated from OpenTofu output, so committing one would
# commit a stale copy of state. A hypervisor is not in the machines map — this
# file *is* the declaration that the node exists, and without it the play has
# nothing to target. Committed without it once already, which passed CI and
# failed on the runner with "No hosts matched".
!builders/ansible/inventories/hypervisors/hosts.yml
builders/ansible/inventories/**/group_vars/
builders/ansible/inventories/**/host_vars/

# Editor / OS
__pycache__/
.DS_Store
*.swp
*~

# Local hardware notes (optional personal files)
docs/proxmox/hardware/local-*

# IDE / local tool config
.cursor/
.opencode/
config.json

# Local tool indexes
.codegraph/
.slim/deepwork/
